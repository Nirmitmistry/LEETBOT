# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://your_user:your_password@your_cluster.mongodb.net/?appName=YourApp
MONGO_DB_NAME=leetbot_db
MONGO_PROBLEMS_COLLECTION=problems

# ── Gemini API (Embeddings + LLM) ────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EMBEDDING_MODEL=models/text-embedding-004
GEMINI_EMBED_BATCH_SIZE=100
GEMINI_MODEL_NAME=gemini-1.5-flash

# ── OpenAI (Ingestion Embeddings) ────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Chroma (local vector store) ──────────────────────────────────────────────
CHROMA_PATH=./chroma_db
CHROMA_COLLECTION=leetcode_chunks

# ── JWT Authentication ───────────────────────────────────────────────────────
# IMPORTANT: Generate a strong secret! Run:
#   python -c "import secrets; print(secrets.token_hex(32))"
# NEVER use a weak value like "12345" in production!
JWT_SECRET=
JWT_EXPIRE_MINUTES=1440
JWT_ALGORITHM=HS256

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# Local dev:   http://localhost:5173
# Production:  https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173

# ── Reranker ─────────────────────────────────────────────────────────────────
# Backend: 'local' (sentence-transformers) or 'cohere' (Cohere Rerank API)
RERANKER_BACKEND=local

# Number of candidates to pull from Chroma before reranking
RERANKER_CANDIDATE_K=25

# Documents to keep after reranking (fed to the LLM)
RERANKER_TOP_N=4

# Drop chunks below this score.
#   local  → raw CrossEncoder logits, typically [-10, 10]; -5.0 is conservative
#   cohere → scores in [0, 1]; set to e.g. 0.05 when using Cohere
RERANKER_THRESHOLD=-5.0

# sentence-transformers model (only used when RERANKER_BACKEND=local)
RERANKER_LOCAL_MODEL=BAAI/bge-reranker-large

# Cohere API key (only required when RERANKER_BACKEND=cohere)
COHERE_API_KEY=

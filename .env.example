# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://your_user:your_password@your_cluster.mongodb.net/?appName=YourApp
MONGO_DB_NAME=leetbot_db
MONGO_PROBLEMS_COLLECTION=problems

# ── Gemini API (Embeddings + LLM) ────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EMBEDDING_MODEL=models/text-embedding-004
GEMINI_EMBED_BATCH_SIZE=100
GEMINI_MODEL_NAME=gemini-1.5-flash

# ── OpenAI (Ingestion Embeddings) ────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Chroma (local vector store) ──────────────────────────────────────────────
CHROMA_PATH=./chroma_db
CHROMA_COLLECTION=leetcode_chunks

# ── JWT Authentication ───────────────────────────────────────────────────────
# IMPORTANT: Generate a strong secret! Run:
#   python -c "import secrets; print(secrets.token_hex(32))"
# NEVER use a weak value like "12345" in production!
JWT_SECRET=
JWT_EXPIRE_MINUTES=1440
JWT_ALGORITHM=HS256

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# Local dev:   http://localhost:5173
# Production:  https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173

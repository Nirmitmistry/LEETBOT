# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://your_user:your_password@your_cluster.mongodb.net/?appName=YourApp
MONGO_DB_NAME=leetbot_db
MONGO_PROBLEMS_COLLECTION=problems

# ── Gemini API (Embeddings + LLM) ────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
GEMINI_EMBED_BATCH_SIZE=100
GEMINI_MODEL_NAME=gemini-3.6-flash

# ── Ingestion ────────────────────────────────────────────────────────────────
# Problems per batch. Keep at 10 on Gemini free tier (100 embedContent req/min).
# Raise to 50 on a paid API key.
INGESTION_BATCH_SIZE=10
# Seconds to sleep between batches (free tier). Set to 0 on paid key.
INGESTION_BATCH_DELAY_S=65

# ── Chroma (local vector store) ──────────────────────────────────────────────
CHROMA_PATH=./chroma_db
CHROMA_COLLECTION=leetcode_chunks

# ── JWT Authentication ───────────────────────────────────────────────────────
# IMPORTANT: Generate a strong secret! Run:
#   python -c "import secrets; print(secrets.token_hex(32))"
# NEVER use a weak value like "12345" in production!
JWT_SECRET=
JWT_EXPIRE_MINUTES=1440
JWT_ALGORITHM=HS256

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# Local dev:   http://localhost:5173
# Production:  https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173

# ── Reranker ─────────────────────────────────────────────────────────────────
# Backend: 'local' (sentence-transformers) or 'cohere' (Cohere Rerank API)
RERANKER_BACKEND=local

# Number of candidates to pull from Chroma before reranking
RERANKER_CANDIDATE_K=25

# Documents to keep after reranking (fed to the LLM)
RERANKER_TOP_N=4

# Drop chunks below this score.
#   local  → raw CrossEncoder logits, typically [-10, 10]; -5.0 is conservative
#   cohere → scores in [0, 1]; set to e.g. 0.05 when using Cohere
RERANKER_THRESHOLD=-5.0

# sentence-transformers model (only used when RERANKER_BACKEND=local)
RERANKER_LOCAL_MODEL=BAAI/bge-reranker-large

# Cohere API key (only required when RERANKER_BACKEND=cohere)
COHERE_API_KEY=

# ── Hybrid Retrieval (A/B testing flags) ─────────────────────────────────────
# Enable BM25 sparse retrieval leg combined with dense Chroma search via RRF.
# Set to 'false' for dense-only mode (useful for A/B comparison).
HYBRID_RETRIEVAL=true

# Enable query transformation before retrieval:
#   - Vague queries (<6 words or hedge words) → HyDE hypothetical answer
#   - Specific queries → 2-3 multi-query reformulations, all fused with RRF
# Set to 'false' to pass the raw query directly (useful for A/B comparison).
QUERY_TRANSFORM=true

# Total candidate documents from hybrid retrieval passed to the reranker.
# Should be larger than RERANKER_CANDIDATE_K to give the reranker more material.
HYBRID_CANDIDATE_K=30

# ── Semantic cache (Redis + RedisVL) ─────────────────────────────────────────
# Redis connection URL.
# Local dev:   redis://localhost:6379/0
# Production:  redis://:<password>@<host>:<port>/0   (or rediss:// for TLS)
REDIS_URL=redis://localhost:6379/0

# Minimum cosine similarity (0–1) for a semantic cache hit.
# Only cache entries with similarity ≥ this threshold are returned.
# Default 0.92 — high precision to avoid returning hints for different queries.
SEMANTIC_CACHE_THRESHOLD=0.92

# TTL for cached hint entries, in seconds.
# Default: 604800 = 7 days.  Expire entries so refined problem content
# is reflected after at most one TTL period.
SEMANTIC_CACHE_TTL_S=604800

# ── RAG evaluation harness ────────────────────────────────────────────────────
# Minimum aggregate faithfulness score to pass the CI gate.
# Run: python -m backend.rag.eval.run
# Exit code 0 = passed, 1 = faithfulness below threshold, 2 = hard error.
EVAL_FAITHFULNESS_THRESHOLD=0.85

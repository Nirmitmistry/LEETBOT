# ─────────────────────────────────────────────────────────────────────────────
# LeetBot — Backend Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── MongoDB ──────────────────────────────────────────────────────────────────
# Full MongoDB Atlas (or local) connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Name of the MongoDB database
MONGO_DB_NAME=leetbot_db

# Name of the problems collection inside that database
MONGO_PROBLEMS_COLLECTION=problems

# ── OpenAI ───────────────────────────────────────────────────────────────────
# Used for generating embeddings (text-embedding-3-small by default)
OPENAI_API_KEY=sk-...

# Override the embedding model if needed (optional)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Number of texts sent to OpenAI per embedding API call (optional)
OPENAI_EMBED_BATCH_SIZE=100

# ── Chroma (local vector store) ───────────────────────────────────────────────
# Filesystem path where Chroma persists its data
CHROMA_PATH=./chroma_db

# Chroma collection name — must match between ingestion and the API server
CHROMA_COLLECTION=leetcode_chunks

# ── Ollama (local LLM) ───────────────────────────────────────────────────────
# Base URL of your running Ollama instance
OLLAMA_BASE_URL=http://localhost:11434

# Model tag as it appears in `ollama list`
OLLAMA_MODEL_NAME=qwen2.5-coder:7b

# ── JWT Authentication ────────────────────────────────────────────────────────
# Long random secret — generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_secret

# Token lifetime in minutes (default: 1440 = 24 hours)
JWT_EXPIRE_MINUTES=1440

# JWT signing algorithm (default: HS256 — change only if you know why)
JWT_ALGORITHM=HS256

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# Local dev:   http://localhost:5173
# Production:  https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173

# ── Scraper ───────────────────────────────────────────────────────────────────
# Your LeetCode session cookie value (for authenticated scraping)
LEETCODE_SESSION=your_leetcode_session_cookie

# Delay in seconds between scraper requests (be polite to LeetCode's servers)
SCRAPE_DELAY=1.5
